<div class="page-header">
    <h1 class="page-title">Account Holders</h1>
</div>

<div class="add-form-container">
    <h3>Link Customer to Account</h3>
    <form action="/account-holders/add" method="POST" style="margin-top: 1rem; display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
        <div class="form-group" style="flex: 1; min-width: 200px;">
            <label>Customer</label>
            <select name="customerId" class="form-control" required style="background: rgba(15, 23, 42, 0.6); color: white;">
                <% customers.forEach(c => { %>
                    <option value="<%= c.CustomerID %>"><%= c.Name %> (ID: <%= c.CustomerID %>)</option>
                <% }) %>
            </select>
        </div>
        <div class="form-group" style="flex: 1; min-width: 200px;">
            <label>Account No</label>
            <select name="accountNo" class="form-control" required style="background: rgba(15, 23, 42, 0.6); color: white;">
                <% accounts.forEach(a => { %>
                    <option value="<%= a.AccountNo %>"><%= a.AccountNo %></option>
                <% }) %>
            </select>
        </div>
        <button type="submit" class="btn btn-primary" style="margin-bottom: 1rem;">Link Account</button>
    </form>
</div>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Customer Name</th>
                <th>Customer ID</th>
                <th>Account No</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (holders.length === 0) { %>
                <tr>
                    <td colspan="4" style="text-align: center; color: var(--text-muted);">No account links found.</td>
                </tr>
            <% } else { %>
                <% holders.forEach(holder => { %>
                    <tr>
                        <td><%= holder.CustomerName %></td>
                        <td><%= holder.CustomerID %></td>
                        <td><%= holder.AccountNo %></td>
                        <td>
                            <form action="/account-holders/delete" method="POST" onsubmit="return confirm('Remove this link?');">
                                <input type="hidden" name="customerId" value="<%= holder.CustomerID %>">
                                <input type="hidden" name="accountNo" value="<%= holder.AccountNo %>">
                                <button type="submit" class="btn btn-danger">Unlink</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>
</div>
