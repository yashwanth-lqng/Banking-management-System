<div class="page-header">
    <h1 class="page-title">Loans</h1>
</div>

<% if (!isCustomer) { %>
<div class="add-form-container">
    <h3>Add New Loan</h3>
    <form action="/loans/add" method="POST" style="margin-top: 1rem; display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
        <div class="form-group" style="flex: 1; min-width: 100px;">
            <label>Loan ID</label>
            <input type="number" name="loanId" class="form-control" required>
        </div>
        <div class="form-group" style="flex: 2; min-width: 150px;">
            <label>Loan Type</label>
            <input type="text" name="loanType" class="form-control" required placeholder="e.g. Home Loan">
        </div>
        <div class="form-group" style="flex: 1; min-width: 120px;">
            <label>Amount</label>
            <input type="number" step="0.01" name="amount" class="form-control" required>
        </div>
        <div class="form-group" style="flex: 2; min-width: 150px;">
            <label>Customer</label>
            <select name="customerId" class="form-control" required style="background: rgba(15, 23, 42, 0.6); color: white;">
                <% customers.forEach(c => { %>
                    <option value="<%= c.CustomerID %>"><%= c.Name %></option>
                <% }) %>
            </select>
        </div>
        <div class="form-group" style="flex: 2; min-width: 150px;">
            <label>Branch</label>
            <select name="branchId" class="form-control" required style="background: rgba(15, 23, 42, 0.6); color: white;">
                <% branches.forEach(b => { %>
                    <option value="<%= b.BranchID %>"><%= b.Name %></option>
                <% }) %>
            </select>
        </div>
        <div class="form-group" style="flex: 1; min-width: 100px;">
            <label>Interest Rate (%)</label>
            <input type="number" step="0.01" name="interestRate" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-primary" style="margin-bottom: 1rem;">Add Loan</button>
    </form>
</div>
<% } %>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Loan ID</th>
                <th>Type</th>
                <th>Amount</th>
                <th>Customer</th>
                <th>Branch</th>
                <th>Interest Rate</th>
                <% if (!isCustomer) { %>
                <th>Actions</th>
                <% } %>
            </tr>
        </thead>
        <tbody>
            <% if (loans.length === 0) { %>
                <tr>
                    <td colspan="<%= isCustomer ? 6 : 7 %>" style="text-align: center; color: var(--text-muted);">No loans found.</td>
                </tr>
            <% } else { %>
                <% loans.forEach(loan => { %>
                    <tr>
                        <td><%= loan.LoanID %></td>
                        <td><%= loan.LoanType %></td>
                        <td>$<%= parseFloat(loan.Amount).toFixed(2) %></td>
                        <td><%= loan.CustomerName || loan.CustomerID %></td>
                        <td><%= loan.BranchName || loan.BranchID %></td>
                        <td><%= parseFloat(loan.InterestRate).toFixed(2) %>%</td>
                        <% if (!isCustomer) { %>
                        <td>
                            <form action="/loans/delete" method="POST" onsubmit="return confirm('Delete this loan?');">
                                <input type="hidden" name="loanId" value="<%= loan.LoanID %>">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </td>
                        <% } %>
                    </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>
</div>
