<div class="glass-card mb-4">
    <h3>Add New Customer</h3>
    <form action="/customers/add" method="POST" class="flex-panel mt-4">
        <div class="form-group flex-1">
            <label>Customer ID (Auto on DB but provide number)</label>
            <input type="number" name="customerId" class="form-control" required>
        </div>
        <div class="form-group flex-1">
            <label>Name</label>
            <input type="text" name="name" class="form-control" required>
        </div>
        <div class="form-group flex-1">
            <label>Password</label>
            <input type="password" name="password" class="form-control" placeholder="Default: password" required>
        </div>
        <div class="form-group flex-1">
            <label>Phone</label>
            <input type="text" name="phone" class="form-control" required>
        </div>
        <div class="form-group" style="width: 100%;">
            <label>Address</label>
            <input type="text" name="address" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%;">Add Customer</button>
    </form>
</div>

<div class="glass-card table-container">
    <h3 class="mb-3">Customer Directory</h3>
    <table>
        <thead>
            <tr>
                <th>Customer ID</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Address</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (customers.length === 0) { %>
                <tr>
                    <td colspan="5" style="text-align: center; color: var(--text-secondary);">No customers found.</td>
                </tr>
            <% } else { %>
                <% customers.forEach(customer => { %>
                    <tr>
                        <td><%= customer.CustomerID %></td>
                        <td><%= customer.Name %></td>
                        <td><%= customer.Phone %></td>
                        <td><%= customer.Address %></td>
                        <td>
                            <form action="/customers/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this customer?');">
                                <input type="hidden" name="customerId" value="<%= customer.CustomerID %>">
                                <button type="submit" class="btn btn-danger">Delete (Soft)</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>
</div>
