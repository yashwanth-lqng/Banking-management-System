<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NeoBank | Secure Banking</title>
    <!-- Modern Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

    <nav class="glass-nav">
        <a href="/" class="nav-brand">
            <span class="brand-accent">Neo</span>Bank
        </a>
        <div class="nav-links">
            <% if (user) { %>
                <a href="/">Dashboard</a>
                
                <% if (user.role === 'admin') { %>
                    <a href="/branches">Branches</a>
                    <a href="/customers">Customers</a>
                    <a href="/accounts">Accounts</a>
                    <a href="/account-holders">Acc Holders</a>
                <% } %>
                
                <a href="/transactions">Transactions</a>
                <a href="/loans">Loans</a>

                <div class="user-profile">
                    <span class="greeting">Hi, <%= user.name %>!</span>
                    <a href="/logout" class="btn-logout">Logout</a>
                </div>
            <% } else { %>
                <a href="/login" class="btn-primary">Login</a>
            <% } %>
        </div>
    </nav>

    <div class="container main-container">
        <%- body %>
    </div>

    <footer class="glass-footer">
        &copy; <%= new Date().getFullYear() %> NeoBank. All rights reserved. <br>
        <small>Next-Generation Banking Protocol</small>
    </footer>

</body>
</html>
