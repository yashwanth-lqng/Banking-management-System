<div class="page-header">
    <h1 class="page-title">Branches</h1>
</div>

<div class="add-form-container">
    <h3>Add New Branch</h3>
    <form action="/branches/add" method="POST" style="margin-top: 1rem; display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
        <div class="form-group" style="flex: 1; min-width: 150px;">
            <label>Branch ID</label>
            <input type="number" name="branchId" class="form-control" required>
        </div>
        <div class="form-group" style="flex: 2; min-width: 200px;">
            <label>Name</label>
            <input type="text" name="name" class="form-control" required>
        </div>
        <div class="form-group" style="flex: 3; min-width: 250px;">
            <label>Address</label>
            <input type="text" name="address" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-primary" style="margin-bottom: 1rem;">Add Branch</button>
    </form>
</div>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Branch ID</th>
                <th>Name</th>
                <th>Address</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (branches.length === 0) { %>
                <tr>
                    <td colspan="4" style="text-align: center; color: var(--text-muted);">No branches found.</td>
                </tr>
            <% } else { %>
                <% branches.forEach(branch => { %>
                    <tr>
                        <td><%= branch.BranchID %></td>
                        <td><%= branch.Name %></td>
                        <td><%= branch.Address %></td>
                        <td>
                            <form action="/branches/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this branch?');">
                                <input type="hidden" name="branchId" value="<%= branch.BranchID %>">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>
</div>
